{
  "name": "pharm-atlas",
  "productName": "PharmAtlas",
  "version": "1.1.0",
  "description": "A retro desktop medication scheduler, inventory tracker, and vitals log.",
  "author": "Daniel Uribe",
  "main": "main.js",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "electron": "^40.6.1"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test:demo": "npm run mobile:build && electron tests/full-demo.cjs",
    "screenshots:iphone": "npm run mobile:build && electron tests/full-demo.cjs --device iphone --capture-dir docs/app-store/screenshots/iphone",
    "screenshots:ipad": "npm run mobile:build && electron tests/full-demo.cjs --device ipad --capture-dir docs/app-store/screenshots/ipad",
    "mobile:build": "node scripts/build-mobile.js",
    "cap:sync": "npm run mobile:build && cap sync",
    "cap:add:ios": "npm run mobile:build && cap add ios",
    "cap:open:ios": "cap open ios",
    "cap:run:ios": "cap run ios"
  },
  "dependencies": {
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "98.css": "^0.1.21",
    "bwip-js": "^4.11.2",
    "electron-squirrel-startup": "^1.0.1",
    "nodemailer": "^8.0.2",
    "qrcode-generator": "^1.4.4"
  }
}
